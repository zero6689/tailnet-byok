# ---------------------------------------------------------------------------
# tailnet-byok — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and MUST stay that way.
#
# Read this first: NOTHING in this file reaches the phone, and nothing here is
# ever compiled into the APK. `.env` only feeds *build and release tooling*
# (CI signing, the optional personal-site sync). The user's Tailscale auth key
# and target host are entered in the app UI at runtime and stored encrypted in
# the Android Keystore — they never appear in this file, in the repo, or in a
# build log.
# ---------------------------------------------------------------------------

# --- Release signing (CI only) ---------------------------------------------
# Base64-encoded keystore, produced with:
#   base64 -w0 release.jks        # Linux
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("release.jks"))   # Windows
KEYSTORE_BASE64=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# --- Optional: personal-site sync ------------------------------------------
# Used by .github/workflows/sync-personal-site.yml (manual dispatch only).
# Leave empty to disable the job entirely.
PERSONAL_SITE_HOST=
PERSONAL_SITE_USER=
PERSONAL_SITE_PATH=/var/www/tailnet-byok
# SSH private key, base64-encoded. NEVER commit the decoded key.
PERSONAL_SITE_SSH_KEY_BASE64=
PERSONAL_SITE_KNOWN_HOSTS=

# --- Local build overrides (optional) --------------------------------------
# Baked into BuildConfig as a NON-SECRET default. Leave empty to let the
# skeleton default (https://controlplane.tailscale.com) apply.
# Set this only when you are shipping a build that should default to your own
# self-hosted control plane (headscale). It is not a secret, but it is public
# once the APK is published — do not put anything private here.
DEFAULT_CONTROL_URL=

# --- Docs site -------------------------------------------------------------
# Base path for GitHub Pages project sites, e.g. "/tailnet-byok".
DOCS_BASE_PATH=/tailnet-byok

# --- Website sync target (optional) ----------------------------------------
# Where the personal-site sync copies the built docs site.
PERSONAL_SITE_URL=https://example.com/tailnet-byok/
