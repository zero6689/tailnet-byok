<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Launcher icon background.

      White, to match the brand art: the whale is drawn blue-on-white, with white
      belly and eye patches that only read correctly against a light plate. On a
      dark background the belly disappears into the plate and the mark turns into
      an unreadable blue blob.

      This is also why the foreground PNG is opaque rather than transparent: it
      carries the white ground with it, so the two layers cannot disagree.
    -->
    <color name="ic_launcher_background">#FFFFFF</color>
</resources>
