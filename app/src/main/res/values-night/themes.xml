<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The dark counterpart. Only the window background changes; the Compose theme
      reads the system setting itself, and the system-bar icon tint is applied by
      `enableEdgeToEdge()`.
    -->
    <style name="Theme.TailnetByok" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E1420</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
