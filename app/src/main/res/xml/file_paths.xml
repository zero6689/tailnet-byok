<?xml version="1.0" encoding="utf-8"?>
<!--
  What the FileProvider may serve, and nothing more.

  Two entries, each with exactly one job:

    * `updates/` — where a verified download is staged for the package installer.
    * `capture/` — where the system camera writes the photo an upload asked for,
      when the page's file input allows one.

  It is deliberately not `files-path`, not `external-path`, and not a catch-all —
  a provider that can serve everything is a provider that can leak everything.

  Both directories live in the cache because both are disposable transfers:
  Android may reclaim them under pressure, and the app treats "the file is gone"
  as a normal outcome (re-check for the update; ask the page to pick again) rather
  than an error.
-->
<paths>
    <cache-path
        name="updates"
        path="updates/" />
    <cache-path
        name="capture"
        path="capture/" />
</paths>
