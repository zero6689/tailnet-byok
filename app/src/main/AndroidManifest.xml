<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions, and why each one is here. Anything not justified below is
      absent on purpose: an app that asks for less is an app that can do less
      damage when it is compromised.

      INTERNET            — required to reach the control plane and the target
                            host over the tailnet.
      ACCESS_NETWORK_STATE— used only to report "no underlying network" as a
                            distinct, actionable error in the connection test.
                            It does not read any network payload.
      POST_NOTIFICATIONS  — Android 13+. Only when the user opts into a
                            persistent "tailnet connected" notification.
                            Not a VPN app: there is no foreground VPN service.
      REQUEST_INSTALL_PACKAGES
                          — so the in-app updater can hand a downloaded,
                            hash-verified build to the system installer. It does
                            not let this app install anything by itself: Android
                            still requires the user to have allowed installs from
                            this app, and the system installer always shows the
                            package and asks. Nothing is installed silently.

      Deliberately NOT requested:
        * BIND_VPN_SERVICE      — the embedded tsnet node dials a single
                                  destination inside its own process. It never
                                  intercepts device-wide traffic, so it must
                                  not ask for the VPN slot.
        * QUERY_ALL_PACKAGES    — nothing here needs to enumerate other apps.
        * READ/WRITE_EXTERNAL   — exports go through the Storage Access
                                  Framework, which grants a single file.
        * ACCESS_FINE_LOCATION  — never. Not for "nearby networks", not ever.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".TailnetByokApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TailnetByok"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Configuration links: `dshbyok://setup?target=…&mode=…`.

              This is how a deployment hands the app its address without baking one
              into the APK: the server prints the link (or a QR code containing it),
              any camera or scanner app opens it, and this activity receives it.

              Two deliberate limits. It is a *custom scheme*, not an https app link,
              so no domain ownership is implied and no verification is needed. And it
              is not exported for anything else: no other action, no other category,
              so the only way in is an explicit view of this URI.

              What the link may say is enforced in `domain/SetupLink.kt`, and *when*
              it takes effect is enforced in the UI: a link never applies itself —
              the user confirms it after seeing the target it points at.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dshbyok" android:host="setup" />
            </intent-filter>
        </activity>

        <!--
          No <service> and no <receiver>, and the only <provider> is the
          unexported FileProvider below. Nothing in this manifest is an IPC
          surface another app can reach except the launcher activity itself.
        -->

        <!--
          The one provider in this app, and it is not an IPC surface.

          It exists for a single job: handing the downloaded update to the system
          package installer, which runs in another process and therefore cannot be
          given a `file://` URI (that has thrown FileUriExposedException since
          Android 7). It is `exported="false"` with
          `grantUriPermissions="true"`, so the only way to read anything through it
          is a URI this app put in an intent it sent, with a one-shot read grant
          attached. It exposes exactly one directory — the staging directory inside
          `cacheDir` — which is why `file_paths.xml` names that path and nothing
          else.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
