# --- Secrets: never commit any of these ------------------------------------
.env
.env.*
!.env.example
local.properties
*.jks
*.keystore
keystore.properties
secrets.properties
!debug.keystore

# --- Build output ----------------------------------------------------------
build/
.gradle/
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
output.json
release/

# --- Native bridge artifacts (built in CI, see docs/TSNET.md) --------------
# `gomobile bind` emits the AAR plus a sources jar beside it. Both are generated
# from `tailnet/`, both are tens of megabytes, and neither can be reviewed in a
# diff — so neither is committed.
app/libs/*.aar
app/libs/*.jar
!app/libs/README.md
tailnet/mobile.aar
tailnet/mobile-sources.jar

# --- Toolchain downloaded by scripts/fetch-toolchain.mjs -------------------
# Gigabytes of Gradle, Go, SDK and NDK that are reproducible from a version
# number. Never commit it, and never let it be the reason a clone is slow.
.toolchain/

# --- Local Gradle state ----------------------------------------------------
# GRADLE_USER_HOME is redirected here in restricted environments, because Gradle
# unpacks native libraries into it and a read-only $HOME fails at startup.
.gradle-home/

# --- Built docs site -------------------------------------------------------
# site/*.html are templates; the built site is generated by site/build.mjs.
site/dist/

# --- IDE -------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
!.vscode/extensions.json

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / scratch --------------------------------------------------------
*.log
.kotlin/
