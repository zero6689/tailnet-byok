root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{md,html,css}]
indent_size = 2
trim_trailing_whitespace = false

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
